# openstack-cloud-controller-manager on a Red Hat UBI base image. The default
# image is built from the Dockerfile in this directory.

ARG GOLANG_IMAGE=golang:1.26.2

# Pinned to the minor so that the amd64 and arm64 images are built on the same
# base.
ARG UBI_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal:9.8

# The builder always runs on the build platform and cross compiles with go, so
# the arm64 image needs no emulation.
FROM --platform=${BUILDPLATFORM} ${GOLANG_IMAGE} AS builder

ARG TARGETOS
ARG TARGETARCH
ARG VERSION

WORKDIR /build
COPY Makefile go.mod go.sum ./
COPY cmd/ cmd/
COPY pkg/ pkg/
RUN make openstack-cloud-controller-manager GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOPROXY=${GOPROXY} VERSION=${VERSION}

FROM ${UBI_IMAGE} AS openstack-cloud-controller-manager

COPY LICENSE /licenses/LICENSE
COPY --from=builder /build/openstack-cloud-controller-manager /bin/openstack-cloud-controller-manager

LABEL name="openstack-cloud-controller-manager" \
      license="Apache Version 2.0" \
      description="OpenStack cloud controller manager" \
      distribution-scope="public" \
      summary="OpenStack cloud controller manager" \
      help="none"

USER 65534

CMD [ "/bin/openstack-cloud-controller-manager" ]
