{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
        }
      }
    },
    "loadBalancer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "external",
            "internal"
          ]
        },
        "rpcServerAddr": {
          "type": "string",
          "pattern": "^\\S*$"
        },
        "apiKey": {
          "type": "string"
        },
        "tenantID": {
          "$ref": "#/definitions/optionalID"
        },
        "networkID": {
          "$ref": "#/definitions/optionalID"
        },
        "subnetID": {
          "$ref": "#/definitions/optionalID"
        },
        "floatingNetworkID": {
          "$ref": "#/definitions/optionalID"
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "kubeconfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretName": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/."
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "extraInitContainers": {
      "type": "array"
    },
    "extraEnv": {
      "type": "array"
    },
    "resources": {
      "type": "object"
    },
    "livenessProbe": {
      "type": "object"
    },
    "readinessProbe": {
      "type": "object"
    },
    "hostNetwork": {
      "type": "boolean"
    },
    "dnsPolicy": {
      "enum": [
        "ClusterFirst",
        "ClusterFirstWithHostNet",
        "Default",
        "None"
      ]
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array"
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "enabledControllers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(\\*|-?(cloud-node|cloud-node-lifecycle|route|service))$"
      }
    },
    "controllerExtraArgs": {
      "type": "string"
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "additionalLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "logVerbosityLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "cloudConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "networking": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "loadBalancer": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "blockStorage": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "route": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "cloudConfigContents": {
      "type": "string"
    },
    "hostAliases": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "serviceAccountName": {
      "type": "string"
    }
  },
  "definitions": {
    "optionalID": {
      "type": "string",
      "pattern": "^([0-9a-f]{8}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{12})?$"
    }
  }
}
